NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/
MONGODB_DB_NAME=bangkok_tor_db
MATCHING_DEMO_ENABLED=false
# Scoped credential for the AI requirement worker only (32+ characters).
# Keep it on the backend/worker; never expose it to the browser or commit it.
AI_REQUIREMENTS_TOKEN=
# Company-specific AI Evaluation popup. Use the activated n8n production webhook.
TOR_EVALUATION_WEBHOOK_URL=https://n8n.taamtera.com/webhook/eval
TOR_EVALUATION_TIMEOUT_MS=1920000
# Optional shared token; configure the same header credential on the n8n Webhook node.
TOR_EVALUATION_WEBHOOK_TOKEN=
# Optional: absolute Python executable path. Defaults to python on Windows,
# python3 on Linux. Demo mode is restricted to tor_software_test.
# MATCHING_PYTHON_EXECUTABLE=C:/path/to/python.exe

# Authentication
# Secret used to sign access tokens (HMAC-SHA256). REQUIRED in production, min 32 chars.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_ACCESS_SECRET=replace-with-your-own-random-secret-at-least-32-characters
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=7
AUTH_PASSWORD_RESET_TTL_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Email delivery (Gmail SMTP). Use a Google App Password, not your login password.
EMAIL_DELIVERY=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Local-only alternative: EMAIL_DELIVERY=console prints reset links to the terminal.
# Console mode is disabled in production.

# Automatic matching after direct n8n database writes. Existing TORs are baselined on first start.
MATCH_ALERT_WORKER_ENABLED=true
MATCH_ALERT_INTERVAL_MS=60000
# SMTP configuration alone does not enable match mail; each user must explicitly opt in too.
MATCH_ALERT_EMAIL_ENABLED=false
